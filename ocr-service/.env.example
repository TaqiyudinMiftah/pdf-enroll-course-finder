# ============================================================
# PaddleOCR-VL Service — Environment Variables
# Copy ke .env dan sesuaikan
# ============================================================

# Port FastAPI service (default: 8000)
OCR_PORT=8000

# URL vLLM server (default: localhost:8118)
VLLM_BASE_URL=http://localhost:8118/v1

# Model yang digunakan di vLLM (harus sama dengan yang di-serve)
VLLM_MODEL=PaddleOCR-VL-1.6-0.9B

# Timeout request ke vLLM dalam detik (default: 120)
VLLM_TIMEOUT=120

# Maks request dalam antrian (default: 20)
MAX_QUEUE_SIZE=20
