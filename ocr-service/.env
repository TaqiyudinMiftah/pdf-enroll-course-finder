# Konfigurasi OCR Service
# Salin file ini ke .env lalu sesuaikan nilainya

# Port dan host service
OCR_PORT=8000
OCR_HOST=0.0.0.0

# GPU Memory yang dialokasikan untuk PaddleOCR (dalam MB)
# RTX 4050 6GB → aman pakai 4000 (sisakan untuk OS & driver)
GPU_MEM_MB=4000

# Ukuran maksimal antrian request
# Jika penuh, request baru akan langsung ditolak (503)
MAX_QUEUE_SIZE=20

# Bahasa OCR
# CATATAN: PP-Structure layout model hanya support 'en' atau 'ch'
# Gunakan 'en' untuk teks Indonesia (Latin script, compatible)
# LANG tidak digunakan lagi di engine.py — hardcoded ke 'en'
LANG=en
